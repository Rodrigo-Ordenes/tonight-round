{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; frame-src https://open.spotify.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/carrete/[code]",
      "regex": "^/api/carrete/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/api/carrete/(?<nxtPcode>[^/]+?)(?:/)?$"
    },
    {
      "page": "/carrete/[code]",
      "regex": "^/carrete/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/carrete/(?<nxtPcode>[^/]+?)(?:/)?$"
    },
    {
      "page": "/carrete/[code]/opengraph-image",
      "regex": "^/carrete/([^/]+?)/opengraph\\-image(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/carrete/(?<nxtPcode>[^/]+?)/opengraph\\-image(?:/)?$"
    },
    {
      "page": "/icon/[__metadata_id__]",
      "regex": "^/icon/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtP__metadata_id__": "nxtP__metadata_id__"
      },
      "namedRegex": "^/icon/(?<nxtP__metadata_id__>[^/]+?)(?:/)?$"
    },
    {
      "page": "/sala/[code]",
      "regex": "^/sala/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/sala/(?<nxtPcode>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/apple-icon",
      "regex": "^/apple\\-icon(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apple\\-icon(?:/)?$"
    },
    {
      "page": "/armar",
      "regex": "^/armar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/armar(?:/)?$"
    },
    {
      "page": "/bar",
      "regex": "^/bar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/bar(?:/)?$"
    },
    {
      "page": "/carrete",
      "regex": "^/carrete(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/carrete(?:/)?$"
    },
    {
      "page": "/carrete/tv",
      "regex": "^/carrete/tv(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/carrete/tv(?:/)?$"
    },
    {
      "page": "/dividir",
      "regex": "^/dividir(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dividir(?:/)?$"
    },
    {
      "page": "/grupo",
      "regex": "^/grupo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/grupo(?:/)?$"
    },
    {
      "page": "/juegos",
      "regex": "^/juegos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/juegos(?:/)?$"
    },
    {
      "page": "/mitos",
      "regex": "^/mitos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mitos(?:/)?$"
    },
    {
      "page": "/musica",
      "regex": "^/musica(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/musica(?:/)?$"
    },
    {
      "page": "/opengraph-image",
      "regex": "^/opengraph\\-image(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/opengraph\\-image(?:/)?$"
    },
    {
      "page": "/ronda",
      "regex": "^/ronda(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ronda(?:/)?$"
    },
    {
      "page": "/sala",
      "regex": "^/sala(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sala(?:/)?$"
    },
    {
      "page": "/seguridad",
      "regex": "^/seguridad(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/seguridad(?:/)?$"
    },
    {
      "page": "/tiempo",
      "regex": "^/tiempo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tiempo(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}